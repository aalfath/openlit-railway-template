<?xml version="1.0"?>
<!-- Keeps ClickHouse's own logging small so the volume holds OpenLIT data.
     Based on upstream OpenLIT's assets/clickhouse-config.xml, rewritten for
     ClickHouse 26.x (which rejects the old <system_log> element). -->
<clickhouse>
    <logger>
        <level>warning</level>
        <console>true</console>
    </logger>
    <query_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
        <flush_interval_milliseconds>60000</flush_interval_milliseconds>
    </query_log>
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <latency_log remove="1"/>
    <query_metric_log remove="1"/>
    <processors_profile_log remove="1"/>
    <part_log remove="1"/>
    <error_log remove="1"/>
</clickhouse>
